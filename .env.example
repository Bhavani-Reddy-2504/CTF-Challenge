# StrataCore: The Hyperion Enclave Fabric
# Production Server Environment Configuration Example
#
# IMPORTANT:
# This file is an example template for server operators.
# Never commit real flags or production secrets to this repository or release packages.

# Required production secret (must be provided in the server environment)
ENCLAVE_FLAG=REPLACE_ON_SERVER_ONLY

# Network configuration
HOST=0.0.0.0
NODE_ENV=production

# --- HTTPS / TLS Configuration ---

# HTTPS listening port (default: 443 in production, 8443 in dev)
HTTPS_PORT=443

# HTTP port for HTTP->HTTPS redirect (set to 0 to disable, e.g. behind a TLS proxy)
# Default: 80 in production, 8080 in dev
HTTP_REDIRECT_PORT=80

# TLS certificate paths (REQUIRED in production)
# Obtain a certificate from Let's Encrypt (free): https://letsencrypt.org/
# Example: certbot certonly --standalone -d yourdomain.com
# Then set:
TLS_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# Minimum TLS protocol version (TLSv1.2 or TLSv1.3 only)
# Recommendation: TLSv1.3 for highest security; TLSv1.2 for broader compatibility
TLS_MIN_VERSION=TLSv1.2

# Cookie security (always true in production since we serve HTTPS)
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict

# Optional tuning
# SESSION_LIFETIME_MS=7200000
# MAX_ACTIVE_SESSIONS=5000
# LOG_LEVEL=info
